{
  "name": "smartkos",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev -w api\" \"npm run dev -w web\"",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "db:demo": "npm run db:demo -w api",
    "db:generate": "npm run db:generate -w api"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
